<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 3D Three.js Weather WebGL View -->
        <android.webkit.WebView
            android:id="@+id/webView3D"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clWeatherBg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_weather_sunny"
                    android:paddingBottom="40dp">

                    <!-- Top Bar -->
                    <LinearLayout
                        android:id="@+id/llTopBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <!-- Location Pill -->
                        <LinearLayout
                            android:id="@+id/llLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_badge"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="9dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/location_icon_desc"
                                android:src="@drawable/ic_location"
                                app:tint="@color/cyan_accent" />

                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="New York, US" />
                        </LinearLayout>

                        <!-- Menu Button -->
                        <ImageButton
                            android:id="@+id/ibMenu"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_pill_badge"
                            android:contentDescription="@string/menu_desc"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_menu_colorful"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <!-- Search Input Box -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCitySearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        app:boxBackgroundMode="none"
                        app:endIconDrawable="@drawable/ic_search"
                        app:endIconMode="custom"
                        app:endIconTint="@color/cyan_accent"
                        app:hintEnabled="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llTopBar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCitySearch"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_glass_search"
                            android:fontFamily="sans-serif"
                            android:hint="@string/search_hint"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_50"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Severe Weather Alert Banner (Dynamic) -->
                    <LinearLayout
                        android:id="@+id/llWeatherAlert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_alert_banner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tilCitySearch"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Alert Icon"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/alert_amber_text" />

                        <TextView
                            android:id="@+id/tvWeatherAlertText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Weather Advisory: Active conditions monitored"
                            android:textColor="@color/alert_amber_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Weather Icon Hero -->
                    <ImageView
                        android:id="@+id/ivWeatherIcon"
                        android:layout_width="135dp"
                        android:layout_height="135dp"
                        android:layout_marginTop="18dp"
                        android:contentDescription="@string/weather_icon_desc"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llWeatherAlert"
                        tools:src="@drawable/anim_sunny" />

                    <!-- Main Temperature Display -->
                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-thin"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/white"
                        android:textSize="92sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivWeatherIcon"
                        tools:text="25°" />

                    <!-- Weather Description Pill -->
                    <TextView
                        android:id="@+id/tvWeatherDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_pill_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="18dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTemperature"
                        tools:text="Clear Sky" />

                    <!-- Feels Like & High / Low summary -->
                    <TextView
                        android:id="@+id/tvFeelsLikeAndHighLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/white_90"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvWeatherDescription"
                        tools:text="Feels like 26° · H: 28°  L: 19°" />

                    <!-- Hourly Forecast Card -->
                    <LinearLayout
                        android:id="@+id/llForecastContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_glass_card"
                        android:orientation="vertical"
                        android:padding="18dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvFeelsLikeAndHighLow">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Hourly Forecast"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Next 24 Hours"
                                android:textColor="@color/cyan_accent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvForecast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_forecast" />

                    </LinearLayout>

                    <!-- Weather Details Grid (Glass Cards) -->
                    <LinearLayout
                        android:id="@+id/llDetailsGrid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llForecastContainer">

                        <!-- Row 1: Humidity & Wind -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Humidity Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivHumidityIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="@string/humidity_label"
                                    android:src="@drawable/ic_humidity"
                                    app:tint="@color/cyan_accent" />

                                <TextView
                                    android:id="@+id/tvHumidity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="60%" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/humidity_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Wind Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivWindIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="@string/wind_label"
                                    android:src="@drawable/ic_wind"
                                    app:tint="@color/purple_accent" />

                                <TextView
                                    android:id="@+id/tvWindSpeed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="5.0 km/h" />

                                <TextView
                                    android:id="@+id/tvWindDirection"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/wind_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 2: AQI & Visibility -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- AQI Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivAqiIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="@string/air_quality_label"
                                    android:src="@drawable/ic_aqi"
                                    app:tint="@color/aqi_good" />

                                <TextView
                                    android:id="@+id/tvAqi"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="1 · Good" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/air_quality_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Visibility Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivVisibilityIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="@string/visibility_label"
                                    android:src="@drawable/ic_visibility"
                                    app:tint="@color/weather_sun" />

                                <TextView
                                    android:id="@+id/tvVisibility"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="10.0 km" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/visibility_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 3: UV Index & Pressure -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- UV Index Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivUvIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="UV Index"
                                    android:src="@drawable/ic_uv"
                                    app:tint="@color/weather_sun" />

                                <TextView
                                    android:id="@+id/tvUvIndex"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="4 · Moderate" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="UV Index"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Pressure Card -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_card"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <ImageView
                                    android:id="@+id/ivPressureIcon"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:contentDescription="@string/pressure_label"
                                    android:src="@drawable/ic_pressure"
                                    app:tint="@color/teal_accent" />

                                <TextView
                                    android:id="@+id/tvPressure"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="1013 hPa" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/pressure_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Row 4: Sunrise & Sunset Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_glass_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="Sun Position"
                                android:src="@drawable/ic_sunrise"
                                app:tint="@color/amber_accent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSunTimes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/white"
                                    android:textSize="17sp"
                                    android:textStyle="bold"
                                    tools:text="Sunrise: 6:30 AM · Sunset: 7:30 PM" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Solar Trajectory"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <!-- Sliding Menu Drawer -->
    <include
        layout="@layout/sliding_menu"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

</androidx.drawerlayout.widget.DrawerLayout>